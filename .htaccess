# ==============================================================================
# THIRUMALA CONSTRUCTIONS & DEVELOPERS (Tirumala Nirmaan)
# Master Web Server Configuration - Clean Extensionless URLs & Security
# ==============================================================================

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Redirect index.html to Root (/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Clean URLs: Redirect any request with .html extension to extensionless URL (301 Permanent Redirect)
# e.g., https://domain.com/about.html -> https://domain.com/about
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Clean URLs: Internally rewrite extensionless URL to actual .html file
# e.g., https://domain.com/about -> loads about.html seamlessly
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# 4. Security: Block direct browser access to data, log and configuration files
<FilesMatch "^\.|\.csv$|\.log$|\.sql$|\.sh$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 5. Fast Gzip Compression for Optimal Browsing Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
